{
  "name": "macos-agent-bridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Native macOS tools for AI agents, with MCP, Tinycast and Raycast integration.",
  "workspaces": [
    "raycast-extension"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:native": "bash scripts/build-native.sh",
    "build:extension": "node scripts/prepare-extension.cjs && npm run build -w raycast-extension",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p raycast-extension/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "start": "node dist/mcp-server/src/server.js",
    "cli": "tsx mcp-server/src/cli.ts",
    "install:local": "bash scripts/install.sh",
    "postinstall": "node scripts/prepare-extension.cjs",
    "update:local": "npm run build && npm run build:extension && node scripts/update-local.cjs",
    "package:release": "bash scripts/package-local.sh",
    "verify:package": "tsx scripts/verify-package.ts",
    "docs:generate": "tsx scripts/generate-docs.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliusloon/macos-agent-bridge.git"
  },
  "homepage": "https://github.com/juliusloon/macos-agent-bridge#readme",
  "bugs": {
    "url": "https://github.com/juliusloon/macos-agent-bridge/issues"
  },
  "keywords": [
    "macos",
    "mcp",
    "ai-agent",
    "tinycast",
    "raycast",
    "swift",
    "automation"
  ]
}
